rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /vaii_rooms/{roomId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;

      allow create: if request.auth != null
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants
        && (roomId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
          || roomId == request.resource.data.participants[1] + '_' + request.resource.data.participants[0]);

      allow update, delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/vaii_rooms/$(roomId)).data.participants;

        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/vaii_rooms/$(roomId)).data.participants
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.ciphertext is string
          && request.resource.data.ciphertext.size() > 0
          && request.resource.data.ciphertext.size() <= 2000
          && request.resource.data.iv is string
          && request.resource.data.iv.size() >= 16
          && request.resource.data.iv.size() <= 32
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() > 0
          && request.resource.data.senderName.size() <= 30
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }

    match /vaii_schools/{teacherId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == teacherId
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherName is string
        && request.resource.data.teacherName.size() > 0
        && request.resource.data.teacherName.size() <= 30
        && request.resource.data.students is list;

      allow update: if request.auth != null && (
        request.auth.uid == teacherId
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['students'])
          && !(request.auth.uid in resource.data.students)
          && request.resource.data.students.hasAll(resource.data.students)
          && request.auth.uid in request.resource.data.students
          && request.resource.data.students.size() == resource.data.students.size() + 1
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['students'])
          && request.auth.uid in resource.data.students
          && !(request.auth.uid in request.resource.data.students)
          && request.resource.data.students is list
          && resource.data.students.hasAll(request.resource.data.students)
          && request.resource.data.students.size() == resource.data.students.size() - 1
        )
      );

      allow delete: if false;

      match /assessments/{testId} {
        allow read: if request.auth != null && (
          request.auth.uid == teacherId
          || request.auth.uid in get(/databases/$(database)/documents/vaii_schools/$(teacherId)).data.students
        );

        allow create: if request.auth != null
          && request.auth.uid == teacherId
          && request.resource.data.teacherId == teacherId
          && request.resource.data.subject in ['math', 'ela', 'science']
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 80
          && request.resource.data.questions is list
          && request.resource.data.questions.size() >= 1
          && request.resource.data.questions.size() <= 50
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;

        match /submissions/{studentId} {
          allow read: if request.auth != null && (
            request.auth.uid == teacherId
            || request.auth.uid == studentId
          );

          allow create: if request.auth != null
            && request.auth.uid == studentId
            && request.resource.data.studentId == studentId
            && request.resource.data.studentName is string
            && request.resource.data.studentName.size() > 0
            && request.resource.data.studentName.size() <= 30
            && request.resource.data.score is number
            && request.resource.data.totalQuestions is number
            && request.resource.data.answers is list
            && request.resource.data.submittedAt == request.time;

          allow update, delete: if false;
        }
      }
    }
  }
}
